# SirenSync Hospital Intelligence & Bed Management Subsystem
# Local Environment Configuration (Zero External Keys Required)

# Database
DATABASE_URL=sqlite:///./sirensync_hospital.db

# Ranking Engine Weights (Total = 1.0)
WEIGHT_DISTANCE=0.30
WEIGHT_CAPABILITY=0.35
WEIGHT_TRAFFIC=0.20
WEIGHT_BED_AVAILABILITY=0.15

# Maximum Ranking Radius in Kilometers
MAX_RANKING_RADIUS_KM=30.0

# 40% Route-Progress Prototype Bed Reassignment Policy
# Note: This is a configurable prototype heuristic, not a clinical/medical claim.
REASSIGNMENT_ROUTE_THRESHOLD_PERCENT=40.0

# Traffic Provider Configuration
# Options: mock
TRAFFIC_PROVIDER=mock
