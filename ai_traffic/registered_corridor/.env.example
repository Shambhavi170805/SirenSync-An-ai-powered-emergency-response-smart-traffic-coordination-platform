# Optional Nidhi ambulance tracking API integration. Disabled for local demo by default.
SIRENSYNC_TRACKING_API_ENABLED=false
SIRENSYNC_TRACKING_API_BASE_URL=http://127.0.0.1:8000/api/v1
SIRENSYNC_TRACKING_WS_URL=ws://127.0.0.1:8000/api/v1/tracking/ws

# Camera feed and actual map position (omit the coordinates only for a local demo webcam).
SIRENSYNC_CAMERA_URL=0
SIRENSYNC_CAMERA_LAT=
SIRENSYNC_CAMERA_LNG=

# Optional compatible OSRM service. Defaults to the public demo routing endpoint.
SIRENSYNC_ROUTER_BASE_URL=https://router.project-osrm.org
