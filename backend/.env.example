# Optional database overrides. If omitted, the app resolves the existing
# database/ folder beside the repository, then falls back to ./database.
# HOSPITAL_DATABASE_URL=sqlite:////absolute/path/to/database/sirensync_hospital.db
# DATABASE_URL=sqlite:////absolute/path/to/database/sirensync.db

ENVIRONMENT=development

# Cloudflare Turnstile testing secret. Replace with your production secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Optional live traffic-aware driving routes (Google Routes API; billing-enabled project required)
# GOOGLE_MAPS_API_KEY=replace_with_your_server_side_key
